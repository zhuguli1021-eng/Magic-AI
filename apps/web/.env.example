# true（默认）：使用前端模拟数据，不需要后端即可体验全部页面
# false：调用真实 MagicPocket API
NEXT_PUBLIC_USE_MOCK=true

# MagicPocket API 地址（NestJS），接口统一前缀 /api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# 实时语音服务 WebSocket 地址，完整路径为 {VOICE_WS_URL}/v1/voice/training/:sessionId
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:4000

# 后端下发的 TTS 音频采样率（PCM16 单声道）
NEXT_PUBLIC_TTS_SAMPLE_RATE=24000
